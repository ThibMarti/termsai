<aside class="app-sidebar">
  <div class="app-sidebar__brand">
    <%= link_to root_path do %>
      <%= image_tag "logo.png", alt: "Terms AI", class: "app-sidebar__logo" %>
    <% end %>
  </div>

  <nav class="nav flex-column app-sidebar__nav">
    <%= link_to "Scan history", dashboard_path, class: "nav-link #{"active" if current_page?(dashboard_path)}" %>
    <%= link_to "Buy tokens", offers_path, class: "nav-link #{"active" if current_page?(offers_path)}" %>
  </nav>

  <div class="app-sidebar__balance">
    <span class="app-sidebar__balance-label">Tokens</span>
    <span class="app-sidebar__balance-value"><%= current_user.total_scan_allowance %></span>
    <%= link_to "Buy more", offers_path, class: "btn btn-outline-secondary btn-sm app-sidebar__buy-more" %>
  </div>

  <div class="app-sidebar__user">
    <%= image_tag "https://kitt.lewagon.com/placeholder/users/ssaunier", class: "avatar", alt: current_user.email %>
    <div class="app-sidebar__user-info">
      <span class="app-sidebar__user-name"><%= current_user.first_name %> <%= current_user.last_name %></span>
      <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "app-sidebar__logout" %>
    </div>
  </div>
</aside>

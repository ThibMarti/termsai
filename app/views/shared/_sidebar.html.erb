<aside class="offers-sidebar">
  <div class="offers-sidebar__brand">
    <%= link_to "Terms AI", root_path, class: "offers-sidebar__logo" %>
  </div>

  <nav class="nav flex-column offers-sidebar__nav">
    <%= link_to "Scan history", dashboard_path, class: "nav-link" %>
    <%= link_to "Buy tokens", offers_path, class: "nav-link active" %>
  </nav>

  <div class="offers-sidebar__balance">
    <span class="offers-sidebar__balance-label">Tokens</span>
    <span class="offers-sidebar__balance-value"><%= current_user.total_scan_allowance %></span>
  </div>

  <div class="offers-sidebar__user">
    <%= image_tag "https://kitt.lewagon.com/placeholder/users/ssaunier", class: "avatar", alt: current_user.email %>
    <div class="offers-sidebar__user-info">
      <span class="offers-sidebar__user-name"><%= current_user.first_name %> <%= current_user.last_name %></span>
      <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "offers-sidebar__logout" %>
    </div>
  </div>
</aside>

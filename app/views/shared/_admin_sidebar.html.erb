<aside class="app-sidebar">
  <div class="app-sidebar__brand">
    <%= link_to root_path do %>
      <%= image_tag "logo.png", alt: "Terms AI", class: "app-sidebar__logo" %>
    <% end %>
  </div>

  <span class="app-sidebar__section-label">Admin</span>

  <nav class="nav flex-column app-sidebar__nav">
    <%= link_to "Users", admin_users_path, class: "nav-link #{"active" if current_page?(admin_users_path)}" %>
    <%= link_to "Back to app", new_scan_path, class: "nav-link" %>
  </nav>

  <div class="app-sidebar__user">
    <span class="app-sidebar__avatar app-sidebar__avatar--admin"><%= user_initials(current_user) %></span>
    <div class="app-sidebar__user-info">
      <span class="app-sidebar__user-name">Admin</span>
      <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "app-sidebar__logout" %>
    </div>
  </div>
</aside>

<% content_for :title, "#{@scan.site_name.presence || 'Scanning...'} — terms AI" %>

<%= turbo_stream_from "scan_#{@scan.id}" %>

<div class="report">
  <header class="report-header">
    <%= render "shared/hamburger_toggle" %>
    <%= link_to root_path do %>
      <%= image_tag "logo-termsai-V3.jpg", alt: "terms AI", class: "report-header__logo" %>
    <% end %>
    <div class="report-header__actions">
      <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Export</button>
      <%= link_to "New scan", new_scan_path, class: "btn btn-primary btn-sm" %>
    </div>
  </header>

  <%= render "scans/frame", scan: @scan, verdict: @verdict, groups: @groups %>
</div>

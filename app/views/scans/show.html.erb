<%
  report = @scan.full_report
  level_badge_class = { "low" => "bg-success", "medium" => "bg-warning", "high" => "bg-danger" }
%>

<div class="container mt-4" style="max-width: 720px;">
  <h1><%= @scan.site_name %></h1>
  <p class="text-muted"><%= @scan.url %></p>

  <span class="badge <%= risk_badge_class(@scan.risk_score) %>"><%= @scan.risk_score %>/10</span>

  <p class="mt-3"><%= report["summary"] %></p>

  <div class="row row-cols-1 row-cols-md-2 g-3 mt-2">
    <% report["categories"].each do |category| %>
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title d-flex justify-content-between align-items-center">
              <%= category["name"].humanize %>
              <span class="badge <%= level_badge_class[category["level"]] %>"><%= category["level"] %></span>
            </h5>
            <p class="card-text"><%= category["finding"] %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <h2 class="mt-4">GDPR flags</h2>
  <% if report["gdpr_flags"].any? %>
    <ul>
      <% report["gdpr_flags"].each do |flag| %>
        <li><%= flag %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">No GDPR flags.</p>
  <% end %>

  <h2>AI Act flags</h2>
  <% if report["ai_act_flags"].any? %>
    <ul>
      <% report["ai_act_flags"].each do |flag| %>
        <li><%= flag %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">No AI Act flags.</p>
  <% end %>
</div>

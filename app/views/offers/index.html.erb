<% content_for :title, "Buy tokens" %>

<div class="app-shell">
  <%= render "shared/sidebar" %>

  <main class="app-main">
    <span class="report-eyebrow">Billing</span>
    <h1 class="history-title">Buy tokens</h1>
    <p class="offers-explainer">One token scans one document. No subscription — tokens never expire.</p>

    <div class="offers-pack-grid">
      <% @offers.each do |offer| %>
        <div class="card offers-pack-card <%= "offers-pack-card--featured" if offer == @best_value_offer %>">
          <div class="card-body d-flex flex-column">
            <% if offer == @best_value_offer %>
              <div class="offers-pack-card__badge"><%= render "shared/tone_badge", tone: :info, text: "Best value" %></div>
            <% end %>
            <div class="offers-pack-card__tokens"><%= offer.tokens_amount %></div>
            <p class="offers-pack-card__tokens-label">tokens</p>
            <p class="offers-pack-card__price"><%= number_to_currency(offer.price_cents / 100.0, unit: "€", precision: 0) %></p>
            <p class="offers-pack-card__unit-price">
              <%= offer.name %> &middot; <%= number_to_currency(offer.price_cents / offer.tokens_amount.to_f / 100.0, unit: "€", precision: 2) %> / scan
            </p>
            <div class="mt-auto">
              <%= button_to "Buy #{offer.tokens_amount} tokens", orders_path(order: { offer_id: offer.id }),
                    data: { turbo: false },
                    class: "btn #{offer == @best_value_offer ? "btn-primary" : "btn-outline-secondary"} w-100" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </main>
</div>

<% content_for :title, "My profile — terms AI" %>

<div class="detail-page">
  <%= render "shared/back_to_dashboard" %>

  <main class="detail-page__main">
    <div class="history-head">
      <div>
        <span class="report-eyebrow">Account</span>
        <h1 class="history-title">My profile</h1>
      </div>
      <div class="d-flex gap-2">
        <%= link_to "Reset password", new_user_password_path, class: "btn btn-outline-secondary" %>
        <%= link_to "Edit profile", edit_user_registration_path, class: "btn btn-primary" %>
      </div>
    </div>

    <div class="landing-card report-card profile-section">
      <h3 class="report-card__title">Details</h3>
      <dl class="order-summary__list">
        <div><dt>First name</dt><dd><%= current_user.first_name %></dd></div>
        <div><dt>Last name</dt><dd><%= current_user.last_name %></dd></div>
        <div><dt>Email</dt><dd><%= current_user.email %></dd></div>
      </dl>
    </div>

    <div class="landing-card report-card profile-section">
      <h3 class="report-card__title">Billing</h3>
      <dl class="order-summary__list">
        <div>
          <dt>Token balance</dt>
          <dd><%= @tokens_count %> token<%= "s" unless @tokens_count == 1 %></dd>
        </div>
      </dl>

      <div class="profile-billing__actions">
        <%= link_to "Buy more tokens", offers_path, class: "btn btn-primary btn-sm" %>
        <%= link_to "Order history", orders_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <% if @recent_orders.any? %>
        <div class="history-table orders-table profile-billing__orders">
          <div class="history-table__head">
            <span>Offer</span><span>Amount</span><span>Status</span>
          </div>
          <% @recent_orders.each do |order| %>
            <%= link_to order_path(order), class: "history-row orders-row" do %>
              <span class="orders-row__offer"><%= order.offer.name %></span>
              <span class="orders-row__amount"><%= number_to_currency(order.amount_cents / 100.0, unit: "€") %></span>
              <%= render "shared/tone_badge", tone: order.state == "paid" ? :safe : :caution, text: order.state.humanize %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </main>
</div>

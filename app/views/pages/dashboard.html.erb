<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h1>Dashboard</h1>
    <%= link_to "+ New scan", new_scan_path, class: "btn btn-primary" %>
  </div>
  <p class="text-muted">
    <%= @tokens_count %> free token(s) · <%= @credits_amount %> credit(s) · <%= @scans.count %> scan(s)
  </p>

  <% if @scans.any? %>
    <table class="table align-middle">
      <thead>
        <tr><th>Site</th><th>URL</th><th>Score</th><th>Date</th><th></th></tr>
      </thead>
      <tbody>
        <% @scans.each do |scan| %>
          <tr>
            <td><strong><%= scan.site_name %></strong></td>
            <td class="text-muted"><%= scan.url %></td>
            <td><span class="badge <%= risk_badge_class(scan.risk_score) %>"><%= scan.risk_score %>/10</span></td>
            <td><%= scan.created_at.strftime("%d/%m/%Y") %></td>
            <td><%= link_to "See the report", scan_path(scan) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No scan for now</p>
  <% end %>
</div>

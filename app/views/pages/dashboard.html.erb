<% content_for :title, "Home — terms AI" %>

<header class="dashboard-topbar">
  <div class="dashboard-topbar__inner">
    <%= render "shared/hamburger_toggle" %>
    <%= render "shared/app_logo" %>
  </div>
</header>

<main class="dashboard-main">
    <h1 class="history-title">Welcome back, <%= current_user.first_name %></h1>

    <%= link_to "Start a new scan", new_scan_path, class: "btn btn-primary dashboard-cta" %>

    <div class="dashboard-stats">
      <div class="landing-card report-card dashboard-stat">
        <h3 class="report-card__title">Scans</h3>
        <p class="dashboard-stat__value"><%= @scans_count %></p>
        <%= link_to "View history", scan_history_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <div class="landing-card report-card dashboard-stat">
        <h3 class="report-card__title">Tokens</h3>
        <p class="dashboard-stat__value"><%= @tokens_count %></p>
        <%= link_to "Buy more", offers_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <div class="landing-card report-card dashboard-stat">
        <h3 class="report-card__title">Recent scan</h3>
        <% if @recent_scans.any? %>
          <% scan = @recent_scans.first %>
          <%= link_to scan_path(scan), class: "dashboard-stat__scan" do %>
            <span class="dashboard-stat__scan-score dashboard-stat__scan-score--<%= risk_tone(scan.risk_score) %>">
              <%= scan.risk_score.to_i %><span class="dashboard-stat__scan-max">/10</span>
            </span>
            <span class="dashboard-stat__scan-name"><%= scan.site_name %></span>
          <% end %>
        <% else %>
          <p class="dashboard-stat__value">—</p>
        <% end %>
        <%= link_to "View history", scan_history_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    </div>

    <hr class="dashboard-divider">

    <div class="news-feed-section">
      <div class="news-feed-head">
        <%= link_to news_path, class: "news-feed-head__link" do %>
          Explore news <span aria-hidden="true">&rarr;</span>
        <% end %>
      </div>

      <% if @news_articles.any? %>
        <div class="news-feed-grid">
          <% @news_articles.each do |article| %>
            <%= link_to article[:url], target: "_blank", rel: "noopener", class: "news-feed-card" do %>
              <% if article[:image_url].present? %>
                <%= image_tag article[:image_url], alt: "", class: "news-feed-card__img" %>
              <% else %>
                <div class="news-feed-card__placeholder">
                  <i class="fa-solid fa-newspaper"></i>
                </div>
              <% end %>

              <div class="news-feed-card__overlay">
                <%= render "shared/tone_badge",
                      tone: news_category_tone(article[:category]),
                      text: news_category_label(article[:category]) %>
                <h3 class="news-feed-card__title"><%= article[:title] %></h3>
                <span class="news-feed-card__meta"><%= article[:source] %> · <%= time_ago_in_words(article[:published_at]) %> ago</span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted news-feed-empty">Couldn't load news right now — check back later.</p>
      <% end %>
    </div>

    <hr class="dashboard-divider">

    <div class="tips-section">
      <div class="tips-head">
        <%= link_to tricks_and_tips_path, class: "tips-head__link" do %>
          Tricks &amp; tips <span aria-hidden="true">&rarr;</span>
        <% end %>
      </div>

      <div class="tips-teaser-grid">
        <% @tip_teasers.each do |tip| %>
          <%= link_to tricks_and_tips_path, class: "landing-card report-card tips-teaser-card" do %>
            <span class="tips-card__num"><%= tip[:num] %></span>
            <h3 class="tips-card__title"><%= tip[:title] %></h3>
            <p class="tips-card__body"><%= tip[:body] %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </main>
